/*
 * Device Tree Source for MIBOX-668M2 (蜂助手 S1 4G CPE)
 *
 * 硬件：MediaTek MT7628DAN + 2x Quectel EC200（EC200T CAT4 / EC200N CAT1）
 *       16MB SPI-NOR flash（XM25QH128A，128Mbit）/ 64MB DDR2
 *
 * ★★ flash 容量 = 16MiB（2026-10-22 真机四重核实，勿改回）★★
 *
 *   证据 1 芯片型号：dmesg -> spi-nor spi0.0: XM25QH128A (16384 Kbytes)
 *                   XMC XM25QH128A = 128Mbit = 16,384KB（原厂 datasheet）
 *   证据 2 内核截断：同一份 DTB 若写 0x1fb0000(31.6MB)，内核打印
 *                   "partition firmware extends beyond the end of device
 *                    -- size truncated to 0xfb0000"
 *                   截断值必然是「物理容量 - 起始地址」，即 容量 - 0x50000 = 0xfb0000
 *                   => 容量 = 0x1000000 = 16MiB。若真是 8MiB，截断值会是 0x7b0000。
 *   证据 3 分区求和：u-boot 0x30000 + env 0x10000 + factory 0x10000
 *                   + firmware 0xfb0000 = 0x1000000 = 16MiB，分毫不差
 *   证据 4 sysfs  ：/sys/class/mtd/mtd3/size = 16449536 = 15.68MiB（减去前述头部）
 *
 *   曾经照抄 WRTnode 2P 模板写成 0x1fb0000（那是 32MB flash 的板子），
 *   且注释里还写着错的 "8MB"。两者自相矛盾，说明当时根本没验证过。
 *
 *   分区布局（0x50000 + 0xfb0000 = 0x1000000 = 16MiB，与 flash 物理容量封顶）：
 *     u-boot      @ 0x000000  0x030000  read-only
 *     u-boot-env  @ 0x030000  0x010000  read-only
 *     factory     @ 0x040000  0x010000  read-only   （MAC 在偏移 0x28，EEPROM 在 0x0）
 *     firmware    @ 0x050000  0xFB0000              （15.68MB，余下全部）
 */

#include "mt7628an.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "mibox,668m2", "mediatek,mt7628an-soc";   /* ★改：本板 compatible */
	model = "MIBOX-668M2";                                 /* ★改：本板 model */

	chosen {
		bootargs = "console=ttyS0,57600";              /* ★改：波特率 57600 */
	};

	aliases {                                              /* ★加：LED 别名 */
		led-boot = &led_run;
		led-failsafe = &led_run;
		led-running = &led_run;
		led-upgrade = &led_run;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 11 GPIO_ACTIVE_LOW>;        /* ★改：reset = GPIO11 */
			linux,code = <KEY_RESTART>;
		};
	};

	leds {                                                 /* ★加：run / wifi / wan */
		compatible = "gpio-leds";

		led_run: run {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};

		wifi {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		wan {
			function = LED_FUNCTION_WAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 37 GPIO_ACTIVE_LOW>;
		};
	};
};

&state_default {
	/* ★改：按社区固件实际值覆盖 gpio 复用组；★不包含 i2c（模组上电要保持 i2c 功能） */
	gpio {
		groups = "gpio", "refclk", "wdt", "wled_an";
		function = "gpio";
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		broken-flash-reset;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x400>;
					};

					macaddr_factory_28: macaddr@28 {   /* ★改：MAC @ 0x28 */
						reg = <0x28 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				/* 15.68MB：0x50000 + 0xfb0000 = 0x1000000 = 16MiB = flash 物理容量 */
				reg = <0x50000 0xfb0000>;
			};
		};
	};
};

&uart1 {
	status = "okay";
};

&i2c {                                                     /* ★关键：EC200 上电经 I2C 0x39 */
	status = "okay";
};

&ethernet {
	nvmem-cells = <&macaddr_factory_28>;                   /* ★改：MAC 来源 */
	nvmem-cell-names = "mac-address";
};

&esw {
	mediatek,portmap = <0x07>;                             /* ★改：端口映射（WAN 在 1 号口） */
};

&sdhci {
	status = "okay";                                       /* 与官方模板一致 */
};

&pcie {
	status = "okay";                                       /* 与官方模板一致 */
};

&wmac {
	status = "okay";

	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
};
